<Window x:Class="Sonora.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sonora Music" Icon="{StaticResource SonoraMark}" Height="820" Width="1360" MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="104"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBackground}" Padding="22">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="4,10,0,38">
            <Border Width="46" Height="46" CornerRadius="15" Background="#123E3A" Padding="8"><Image Source="{StaticResource SonoraMark}" Stretch="Uniform"/></Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="SONORA" FontSize="19" FontWeight="Bold"/><TextBlock Text="M U S I C" FontSize="9" Foreground="#8FA9A2" Margin="1,2,0,0"/></StackPanel>
          </StackPanel>
          <TextBlock Text="LIBRARY" Foreground="#6F8C84" FontSize="10" FontWeight="Bold" Margin="8,0,0,12"/>
          <Button x:Name="SongsNav" Content="♫    Songs" HorizontalContentAlignment="Left" Background="{DynamicResource SelectedSurface}" Margin="0,0,0,7" Click="SongsNav_Click"/>
          <Button Content="▦    Albums" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,0,0,7" Click="AlbumsNav_Click"/>
          <Button Content="♙    Artists" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,0,0,7" Click="ArtistsNav_Click"/>
          <Button Content="♡    Favorites" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,0,0,7" Click="FavoritesNav_Click"/>
          <Button Content="▤    Playlists" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,0,0,7" Click="PlaylistsNav_Click"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Content="＋   Choose music folder" HorizontalContentAlignment="Left" Background="#153C37" Click="ChooseFolder_Click" Margin="0,0,0,12"/>
          <Button Content="⚙   Settings" HorizontalContentAlignment="Left" Background="Transparent" Click="Settings_Click"/>
          <TextBlock x:Name="FolderLabel" Text="No folder selected" Foreground="{DynamicResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="8,14,8,4"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Grid.Row="0" Margin="34,28,34,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="PageTitle" Text="Your library" FontSize="30" FontWeight="Bold"/><TextBlock Text="Your music, your space." Foreground="{DynamicResource SecondaryText}" Margin="1,5,0,0"/></StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource SearchBackground}" CornerRadius="16" Padding="15,2" Height="48" VerticalAlignment="Center"><DockPanel><TextBlock Text="⌕" FontSize="25" Foreground="{DynamicResource SecondaryText}" Margin="0,0,10,0"/><TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" CaretBrush="{DynamicResource Accent}" FontSize="14" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/></DockPanel></Border>
        <Button x:Name="ThemeButton" Grid.Column="2" Content="☾" Margin="12,0,0,0" Width="48" Height="48" ToolTip="Switch appearance" Click="Theme_Click"/>
      </Grid>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,28,0,18">
        <Border Background="#143B35" CornerRadius="13" Padding="15,8"><TextBlock x:Name="TrackCount" Text="0 TRACKS" Foreground="#65DCCB" FontSize="11" FontWeight="Bold"/></Border>
        <TextBlock x:Name="FolderHint" Text="Choose a folder to start listening" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
      </StackPanel>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBackground}" CornerRadius="20" Padding="12">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="14,0,14,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="90"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
            <TextBlock Text="#" Foreground="#78958C" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="TITLE" Foreground="#78958C" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="ALBUM" Foreground="#78958C" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="DURATION" Foreground="#78958C" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
          </Grid>
          <ListView x:Name="TrackList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#EDF7F3" SelectionChanged="TrackList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="8,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1B302B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1B3932"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
            <ListView.View><GridView AllowsColumnReorder="False">
              <GridViewColumn Width="52"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Number}" Foreground="#719189" VerticalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn Width="420"><GridViewColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#91AAA2" Margin="0,3,0,0"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
              <GridViewColumn Width="190" DisplayMemberBinding="{Binding Album}"/>
              <GridViewColumn Width="90" DisplayMemberBinding="{Binding Duration}"/>
              <GridViewColumn Width="44"><GridViewColumn.CellTemplate><DataTemplate><Button Padding="6,2" Background="Transparent" Foreground="{DynamicResource Accent}" Click="Favorite_Click" Tag="{Binding}" ToolTip="Add to favorites"><Path Data="M12,1 L15.3,8 L23,9 L17.5,14.4 L18.8,22 L12,18.4 L5.2,22 L6.5,14.4 L1,9 L8.7,8 Z" Fill="{DynamicResource Accent}" Stretch="Uniform" Width="16" Height="16"/></Button></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
            </GridView></ListView.View>
          </ListView>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource PlayerBackground}" Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><TextBlock x:Name="NowTitle" Text="Nothing playing" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowArtist" Text="Choose a track from your library" Foreground="#8FA9A1" FontSize="11" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="430">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="|◀" Background="Transparent" Click="Previous_Click" Padding="12,5"/>
            <Button x:Name="PlayButton" Content="▶" Background="#1ABDA9" Foreground="#06201D" FontSize="17" Padding="17,7" Margin="10,0" Click="Play_Click"/>
            <Button Content="▶|" Background="Transparent" Click="Next_Click" Padding="12,5"/>
          </StackPanel>
          <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0" IsMoveToPointEnabled="True" ValueChanged="ProgressSlider_ValueChanged"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="SONORA  •  OFFLINE" Foreground="#78958C" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/>
      </Grid>
    </Border>
  </Grid>
</Window>
